{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stockly",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stockly-db-prod",
      "database_id": "5ad75ef2-f2a1-419e-bc68-90ee139455b7",
    },
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "stockly-media-prod",
    },
  ],
  "ai": {
    "binding": "AI",
  },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
}
