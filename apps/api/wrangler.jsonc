{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stockly-api",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stockly-db",
      "database_id": "local-stockly-db",
    },
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "stockly-media",
    },
  ],
}
