# ==============================================================================
# Stockly Environment Variables (.env)
# ==============================================================================
# コピーして .env を作成し、実際の値を設定してください:
#   cp .env.example .env
#
# 注意: .env は .gitignore に含まれており、Git リポジトリにはコミットされません。
# ==============================================================================

# Cloudflare 認証情報 (本番 IaC / Workers / D1 / R2 プロビジョニング用)
# - CLOUDFLARE_API_TOKEN: Cloudflare ダッシュボードで発行した API トークン
#   (権限: D1:Edit, R2:Edit, Workers Scripts:Edit, Account:Read)
CLOUDFLARE_API_TOKEN=

# - CLOUDFLARE_ACCOUNT_ID: Cloudflare ダッシュボード右下の「アカウント ID」
CLOUDFLARE_ACCOUNT_ID=

# Pulumi 設定 (ローカル暗号化用パスフレーズ。空文字でも可)
PULUMI_CONFIG_PASSPHRASE=
